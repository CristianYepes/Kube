{
   mlx_libX11_leak
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite,indirect
   ...
   obj:*libX11*
}
{
   mlx_libxcb_leak
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite,indirect
   ...
   obj:*libxcb*
}
{
   mlx_init_leak
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite,indirect
   ...
   fun:mlx_init
}
{
   mlx_new_window_leak
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite,indirect
   ...
   fun:mlx_new_window
}
{
   mlx_xpm_leak
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite,indirect
   ...
   fun:mlx_xpm_file_to_image
}
